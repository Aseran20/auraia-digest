<mjml>
  <mj-head>
    <mj-font name="DM Sans" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"></mj-font>
    <mj-attributes>
      <mj-text font-family="'DM Sans', Calibri, Arial, sans-serif" />
      <mj-section padding="0px" />
      <mj-all font-family="'DM Sans', Calibri, Arial, sans-serif" />
    </mj-attributes>
    <mj-style>
      p { margin: 0 !important; }
      @font-face {
        font-family: 'DM Sans';
        mso-font-alt: 'Calibri';
      }
      .tag { display: inline-block; padding: 3px 12px; border-radius: 99px; font-size: 11px; font-weight: 600; }
      .tag-cloud    { background-color: #dbeafe; color: #1e40af; }
      .tag-cyber    { background-color: #fee2e2; color: #991b1b; }
      .tag-data     { background-color: #d1fae5; color: #065f46; }
      .tag-green    { background-color: #fef9c3; color: #854d0e; }
      .tag-services { background-color: #ede9fe; color: #5b21b6; }
      .tag-itsm     { background-color: #e0e7ff; color: #3730a3; }
      .tag-wealth   { background-color: #fdf4ff; color: #7e22ce; }
      .tag-ia-pub   { background-color: #ecfdf5; color: #065f46; }
      .tag-atlassian{ background-color: #fff7ed; color: #c2410c; }
      .tag-logiciels{ background-color: #f0fdf4; color: #15803d; }
      .tag-ingenierie{ background-color: #f1f5f9; color: #334155; }
      .tag-fintech  { background-color: #fffbeb; color: #92400e; }
      .divider-gold { border-color: #D4952A !important; }
    </mj-style>
    <mj-preview>8 acquisitions IT Services — France &amp; Suisse — juillet 2026</mj-preview>
  </mj-head>

  <mj-body width="600px">

    <!-- ====== HEADER ====== -->
    <mj-section padding="32px 40px 24px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column width="55%" vertical-align="middle" padding="0">
        <mj-text font-size="26px" font-weight="700" color="#1a2332" line-height="32px" padding="0px">
          Digest M&amp;A
        </mj-text>
        <mj-text font-size="15px" font-weight="400" color="#374151" line-height="22px" padding="4px 0 0 0">
          IT Services · France &amp; Suisse
        </mj-text>
        <mj-text font-size="12px" color="#4b5563" padding="6px 0 0 0" line-height="18px">
          7–13 juillet 2026 · 8 opérations identifiées
        </mj-text>
      </mj-column>
      <mj-column width="45%" vertical-align="middle" padding="0">
        <mj-image width="160px" alt="Auraïa Capital Advisory" align="right" padding="0px"
          src="data:image/png;base64," />
      </mj-column>
    </mj-section>

    <!-- Spacing -->
    <mj-section padding="6px 0"></mj-section>

    <!-- ====== SYNTHÈSE + RECAP ====== -->
    <mj-section padding="24px 40px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column>
        <mj-text font-size="15px" color="#1f2937" line-height="26px" padding="0px">
          <strong style="color: #111827;">Première quinzaine de juillet 2026.</strong> L'IA agentique s'intègre aux plateformes métiers IT (EasyVista/Konverso, Nexpublica/Wikit) tandis que la consolidation des services managés cloud et cyber se poursuit (Heliaq/Synten, Audensiel/EFIS). Côté Suisse, le rachat de l'activité banque privée de FNZ par Objectway signe une étape majeure dans la consolidation européenne du WealthTech. Huit transactions recensées, toutes sans montant divulgué, reflet d'un marché mid-market animé par des fonds (Sagard, Arkéa Capital, Chevrillon) et des consolidateurs nord-américains en quête de présence européenne.
        </mj-text>
        <mj-spacer height="14px" />
        <mj-text font-size="14px" font-weight="700" color="#111827" line-height="22px" padding="0px">
          Dans ce digest :
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="14px" color="#1f2937" line-height="26px" padding="0px">
          <ul style="margin: 0; padding-left: 18px;">
            <li>EasyVista acquiert Konverso (Non divulgué) — <span class="tag tag-itsm">ITSM &amp; IA</span></li>
            <li>Objectway rachète FNZ Switzerland SA (Non divulgué) — <span class="tag tag-wealth">WealthTech</span></li>
            <li>Nexpublica s'empare de Wikit (Non divulgué) — <span class="tag tag-ia-pub">IA Secteur Public</span></li>
            <li>Heliaq acquiert Synten (Non divulgué) — <span class="tag tag-cloud">Cloud &amp; Infra</span></li>
            <li>Elevatic reprend Elements Apps (Non divulgué) — <span class="tag tag-atlassian">Software Atlassian</span></li>
            <li>Volaris Group achète IVèS (Non divulgué) — <span class="tag tag-logiciels">Logiciels Verticaux</span></li>
            <li>Audensiel acquiert EFIS / iTekway (Non divulgué) — <span class="tag tag-ingenierie">Ingénierie IT</span></li>
            <li>Monext rachète Alcinéo (Non divulgué) — <span class="tag tag-fintech">Fintech &amp; Paiement</span></li>
          </ul>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Spacing -->
    <mj-section padding="6px 0"></mj-section>

    <!-- ====== DEAL 1 — EasyVista → Konverso (Highlight) ====== -->
    <mj-section padding="24px 40px" border="2px solid #D4952A" border-radius="6px">
      <mj-column>
        <mj-image width="32px" src="https://img.logo.dev/easyvista.com?token=pk_a514bKwfQ2OAdSu_uQBOHA&size=128&format=png" alt="EasyVista" padding="0 0 8px 0" align="left" border-radius="4px" />
        <mj-text font-size="10px" font-weight="700" color="#D4952A" letter-spacing="1px" text-transform="uppercase" padding="0px">
          ★ Opération majeure
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="18px" font-weight="700" color="#111827" line-height="26px" padding="0px">
          EasyVista → Konverso
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="13px" color="#4b5563" line-height="22px" padding="0px">
          Annoncé le 2 juillet 2026 · France · Non divulgué · <span class="tag tag-itsm">ITSM &amp; IA</span>
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text font-size="14px" color="#1f2937" line-height="24px" padding="0px">
          EasyVista, leader européen de l'ITSM (~3 000 clients), absorbe Konverso, éditeur de plateforme d'agents IA no-code en croissance de 60 % de son ARR entre 2024 et 2025. L'enjeu : intégrer nativement l'IA agentique dans toute la chaîne IT (support, monitoring, self-healing) et répondre à la pression des DSI pour un déploiement IA immédiatement opérationnel. Konverso est hébergé en Europe et certifié SOC 2 Type II ; ses clients incluent Veolia et Colas.
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="12px" padding="0px">
          <a href="https://www.businesswire.com/news/home/20260702636109/en/EasyVista-Acquires-French-Software-Company-Konverso-Brining-AI-Agents-to-the-Core-of-Its-IT-Platform" style="color: #6b7280; font-weight: 600; text-decoration: none; border-bottom: 1px solid #d1d5db; padding-bottom: 1px;">Source ↗</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="6px 0"></mj-section>

    <!-- ====== DEAL 2 — Objectway → FNZ Switzerland ====== -->
    <mj-section padding="24px 40px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column>
        <mj-image width="28px" src="https://img.logo.dev/objectway.com?token=pk_a514bKwfQ2OAdSu_uQBOHA&size=128&format=png" alt="Objectway" padding="0 0 6px 0" align="left" border-radius="4px" />
        <mj-text font-size="17px" font-weight="700" color="#111827" line-height="26px" padding="0px">
          Objectway → FNZ Switzerland SA (ex-New Access)
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="13px" color="#4b5563" line-height="22px" padding="0px">
          Annoncé le 30 juin 2026 · Suisse · Non divulgué · <span class="tag tag-wealth">WealthTech</span>
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text font-size="14px" color="#1f2937" line-height="24px" padding="0px">
          Objectway (&gt;100 M€ de CA, Milan) rachète à FNZ Group son activité technologique de banque privée suisse, qui sert plus de 40 banques privées avec une équipe de 160+ professionnels. L'acquisition positionne Objectway sur les marchés de gestion de patrimoine cross-border (Suisse, Liechtenstein, Luxembourg, Monaco, Bahamas) et répond à la consolidation du secteur face aux pressions réglementaires et au remplacement des systèmes legacy. Vincent Jeunet, ex-directeur des opérations suisses de FNZ, prend la tête d'Objectway Switzerland.
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="12px" padding="0px">
          <a href="https://www.businesswire.com/news/home/20260630996486/en/Objectway-Acquires-Swiss-Private-Banking-Technology-Business-From-FNZ-to-Strengthen-Its-Pan-European-Positioning" style="color: #6b7280; font-weight: 600; text-decoration: none; border-bottom: 1px solid #d1d5db; padding-bottom: 1px;">Source ↗</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="6px 0"></mj-section>

    <!-- ====== DEAL 3 — Nexpublica → Wikit ====== -->
    <mj-section padding="24px 40px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column>
        <mj-image width="28px" src="https://img.logo.dev/nexpublica.com?token=pk_a514bKwfQ2OAdSu_uQBOHA&size=128&format=png" alt="Nexpublica" padding="0 0 6px 0" align="left" border-radius="4px" />
        <mj-text font-size="17px" font-weight="700" color="#111827" line-height="26px" padding="0px">
          Nexpublica → Wikit
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="13px" color="#4b5563" line-height="22px" padding="0px">
          Annoncé le 2 juillet 2026 · France · Non divulgué · <span class="tag tag-ia-pub">IA Secteur Public</span>
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text font-size="14px" color="#1f2937" line-height="24px" padding="0px">
          Nexpublica (160 M€ CA, 4 000+ organismes publics clients) acquiert Wikit, startup lyonnaise fondée en 2018 qui orchestre des agents IA directement connectés aux outils métiers des collectivités locales – déjà déployée dans 150+ collectivités dont 30 départements et 5 régions. L'enjeu démographique est central : un tiers des fonctionnaires territoriaux partira à la retraite dans la décennie, rendant l'IA agentique structurellement nécessaire. Avec 26 salariés maintenus à Lyon, l'objectif est d'adresser les 45 000 entités publiques françaises.
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="12px" padding="0px">
          <a href="https://www.news-eco.com/communique/nexpublica-acquiert-wikit-pour-deployer-lia-agentique-dans-les-collectivites-locales/" style="color: #6b7280; font-weight: 600; text-decoration: none; border-bottom: 1px solid #d1d5db; padding-bottom: 1px;">Source ↗</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="6px 0"></mj-section>

    <!-- ====== DEAL 4 — Heliaq → Synten ====== -->
    <mj-section padding="24px 40px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column>
        <mj-image width="28px" src="https://img.logo.dev/heliaq.fr?token=pk_a514bKwfQ2OAdSu_uQBOHA&size=128&format=png" alt="Heliaq" padding="0 0 6px 0" align="left" border-radius="4px" />
        <mj-text font-size="17px" font-weight="700" color="#111827" line-height="26px" padding="0px">
          Heliaq → Synten
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="13px" color="#4b5563" line-height="22px" padding="0px">
          Annoncé le 9 juillet 2026 · France · Non divulgué · <span class="tag tag-cloud">Cloud &amp; Infra</span>
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text font-size="14px" color="#1f2937" line-height="24px" padding="0px">
          Heliaq (~400 M€ CA, 700 salariés) réalise sa 5e acquisition depuis sa constitution en mars 2025 par LBO avec Chevrillon et Arkéa Capital : Synten, hébergeur francilien certifié ISO 27001 et HDS spécialisé dans les infogérances critiques, la sauvegarde et la reprise d'activité (~5 M€ CA, ~4 M€ de récurrent, 20 collaborateurs, ~150 clients). L'opération densifie le réseau Île-de-France d'Heliaq Solutions (4 agences, 85 salariés, 60 M€ combinés) et renforce sa capacité à opérer des SI critiques pour des organismes publics et privés.
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="12px" padding="0px">
          <a href="https://heliaq.fr/acquisition-heliaq-acquiert-synten/" style="color: #6b7280; font-weight: 600; text-decoration: none; border-bottom: 1px solid #d1d5db; padding-bottom: 1px;">Source ↗</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="6px 0"></mj-section>

    <!-- ====== DEAL 5 — Elevatic → Elements Apps ====== -->
    <mj-section padding="24px 40px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column>
        <mj-image width="28px" src="https://img.logo.dev/elevatic.com?token=pk_a514bKwfQ2OAdSu_uQBOHA&size=128&format=png" alt="Elevatic" padding="0 0 6px 0" align="left" border-radius="4px" />
        <mj-text font-size="17px" font-weight="700" color="#111827" line-height="26px" padding="0px">
          Elevatic → Elements Apps
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="13px" color="#4b5563" line-height="22px" padding="0px">
          Annoncé le 10 juillet 2026 · France · Non divulgué · <span class="tag tag-atlassian">Software Atlassian</span>
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text font-size="14px" color="#1f2937" line-height="24px" padding="0px">
          Elevatic (Dresde, Allemagne), vendor Platinum de l'Atlassian Marketplace regroupant les marques Communardo Products, bitvoodoo et Mibex, prend le contrôle d'Elements Apps (Toulouse), éditeur d'applications compatibles Jira/JSM fondé en 2017 au sein de Valiantys. L'opération vise à créer un leader européen du marché des add-ons Atlassian, en consolidant une niche très fragmentée où la taille critique est décisive pour peser dans la roadmap du marketplace.
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="12px" padding="0px">
          <a href="https://www.cfnews.net/L-actualite/M-A-Corporate/Operations/100/Elements-rejoint-un-homologue-allemand-720741" style="color: #6b7280; font-weight: 600; text-decoration: none; border-bottom: 1px solid #d1d5db; padding-bottom: 1px;">Source ↗</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="6px 0"></mj-section>

    <!-- ====== DEAL 6 — Volaris Group → IVèS ====== -->
    <mj-section padding="24px 40px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column>
        <mj-image width="28px" src="https://img.logo.dev/volarisgroup.com?token=pk_a514bKwfQ2OAdSu_uQBOHA&size=128&format=png" alt="Volaris Group" padding="0 0 6px 0" align="left" border-radius="4px" />
        <mj-text font-size="17px" font-weight="700" color="#111827" line-height="26px" padding="0px">
          Volaris Group → IVèS
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="13px" color="#4b5563" line-height="22px" padding="0px">
          Annoncé le 9 juillet 2026 · France · Non divulgué · <span class="tag tag-logiciels">Logiciels Verticaux</span>
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text font-size="14px" color="#1f2937" line-height="24px" padding="0px">
          Volaris Group (division de Constellation Software Inc., Canada) acquiert IVèS et ses filiales IVèS Inc et Elioz (marque Solupi), spécialiste français des solutions logicielles d'accessibilité et d'inclusion pour les personnes sourdes et malentendantes, actif en France et au Canada. Impact Partners, minoritaire depuis 2017, sort au closing. La direction (Pascal Dupuy, Didier Chabanol) est maintenue. Volaris cible des éditeurs verticaux rentables à forte récurrence – modèle typique du playbook Constellation.
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="12px" padding="0px">
          <a href="https://www.volarisgroup.com/press-room/volaris-group-acquires-ives/" style="color: #6b7280; font-weight: 600; text-decoration: none; border-bottom: 1px solid #d1d5db; padding-bottom: 1px;">Source ↗</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="6px 0"></mj-section>

    <!-- ====== DEAL 7 — Audensiel → EFIS / iTekway ====== -->
    <mj-section padding="24px 40px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column>
        <mj-image width="28px" src="https://img.logo.dev/audensiel.com?token=pk_a514bKwfQ2OAdSu_uQBOHA&size=128&format=png" alt="Audensiel" padding="0 0 6px 0" align="left" border-radius="4px" />
        <mj-text font-size="17px" font-weight="700" color="#111827" line-height="26px" padding="0px">
          Audensiel → Groupe EFIS / iTekway
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="13px" color="#4b5563" line-height="22px" padding="0px">
          Annoncé le 8 juillet 2026 · France · Non divulgué · <span class="tag tag-ingenierie">Ingénierie IT</span>
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text font-size="14px" color="#1f2937" line-height="24px" padding="0px">
          Audensiel (3 500 collaborateurs, soutenu par Sagard et Capza) acquiert le groupe EFIS (Toulouse) et ses deux filiales iTekway Occitanie et iTekway Île-de-France, deux entreprises adaptées spécialisées dans l'ingénierie IT pour l'aérospatial et le spatial (~5 M€ CA, ~100 salariés dont 75 % en situation de handicap). L'opération implante Audensiel en Occitanie tout en renforçant son engagement RSE via l'emploi inclusif, avec 30 recrutements supplémentaires planifiés sur deux ans.
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="12px" padding="0px">
          <a href="https://www.distributique.com/actualites/lire-audensiel-s-empare-du-groupe-efis-37376.html" style="color: #6b7280; font-weight: 600; text-decoration: none; border-bottom: 1px solid #d1d5db; padding-bottom: 1px;">Source ↗</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="6px 0"></mj-section>

    <!-- ====== DEAL 8 — Monext → Alcinéo ====== -->
    <mj-section padding="24px 40px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column>
        <mj-image width="28px" src="https://img.logo.dev/monext.com?token=pk_a514bKwfQ2OAdSu_uQBOHA&size=128&format=png" alt="Monext" padding="0 0 6px 0" align="left" border-radius="4px" />
        <mj-text font-size="17px" font-weight="700" color="#111827" line-height="26px" padding="0px">
          Monext → Alcinéo
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="13px" color="#4b5563" line-height="22px" padding="0px">
          Annoncé le 7 juillet 2026 · France · Non divulgué · <span class="tag tag-fintech">Fintech &amp; Paiement</span>
        </mj-text>
        <mj-spacer height="10px" />
        <mj-text font-size="14px" color="#1f2937" line-height="24px" padding="0px">
          Monext (filiale B2B de Crédit Mutuel Arkéa, acteur majeur du paiement en France) acquiert Alcinéo (La Ciotat, Bouches-du-Rhône), l'un des rares éditeurs mondiaux de logiciels de paiement embarqué permettant de transformer un smartphone NFC en terminal de paiement. L'opération s'inscrit dans le plan stratégique "Faire 2030" d'Arkéa et vise à internaliser la brique technologique clé pour accélérer l'offre Tap to Pay de Monext, réduisant sa dépendance à des fournisseurs tiers sur un marché en forte croissance.
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="12px" padding="0px">
          <a href="https://presseagence.fr/paris-paiement-monext-acquiert-alcineo-et-vise-la-maitrise-integrale-de-la-chaine-de-valeur/" style="color: #6b7280; font-weight: 600; text-decoration: none; border-bottom: 1px solid #d1d5db; padding-bottom: 1px;">Source ↗</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="6px 0"></mj-section>

    <!-- ====== CTA ====== -->
    <mj-section padding="24px 40px" border="2px solid #D4952A" border-radius="6px">
      <mj-column>
        <mj-text font-size="18px" font-weight="700" color="#111827" line-height="26px" padding="0px">
          Un deal vous interpelle ?
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text font-size="14px" color="#4b5563" line-height="22px" padding="0px">
          Contactez-nous pour une analyse détaillée ou un accompagnement sur une opportunité.
        </mj-text>
        <mj-spacer height="14px" />
        <mj-button font-family="'DM Sans', Calibri, Arial, sans-serif" border-radius="6px" inner-padding="11px 28px" font-size="13px" font-weight="600" background-color="#D4952A" color="#ffffff" align="left" padding="0px" href="mailto:contact@auraia.com">
          Nous contacter
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- ====== FOOTER ====== -->
    <mj-section padding="20px 40px 28px">
      <mj-column>
        <mj-image width="120px" alt="Auraïa Capital Advisory" align="center" padding="0 0 12px 0"
          src="data:image/png;base64," />
        <mj-text align="center" font-size="12px" color="#4b5563" padding="0px" line-height="20px">
          Ce digest est préparé à partir de sources publiques.<br/>Les informations ne constituent pas un conseil en investissement.
        </mj-text>
        <mj-spacer height="6px" />
        <mj-text align="center" font-size="11px" color="#9ca3af" padding="0px">
          Généré le 13 juillet 2026
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
